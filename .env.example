# PostgreSQL Database Configuration
POSTGRES_DB=cyber_soc_db
POSTGRES_USER=soc_admin
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_SECURE_PASSWORD
DATABASE_URL=postgresql+asyncpg://soc_admin:CHANGE_ME_IN_PRODUCTION_SECURE_PASSWORD@localhost:5432/cyber_soc_db

# JWT Authentication & Cryptography
# Generate a secure 32+ byte random string: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS & Network Restrictions (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Initial Security Admin Bootstrap Credentials (Used only on initial startup if no admin exists)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD_123!
